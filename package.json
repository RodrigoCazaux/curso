{
  "name": "inquieto-vinos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt preview",
    "generate": "nuxt generate --preset static",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-inquieto --only firestore,storage \"vitest run test/rules.spec.js\"",
    "test:e2e": "firebase emulators:exec --project demo-inquieto --only auth,firestore,storage \"playwright test\"",
    "rules:prepare": "node scripts/prepare-rules.mjs",
    "test:integration": "firebase emulators:exec --project demo-inquieto --only auth,firestore,storage \"vitest run && playwright test\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vuex": "^4.1.0",
    "firebase": "^12.0.0",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@vue/test-utils": "^2.4.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "vitest": "^4.0.0",
    "jsdom": "^27.0.0",
    "@playwright/test": "^1.55.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^15.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "brace-expansion@^2.0.0": "^2.1.7",
    "picomatch@^2.0.0": "^2.3.2",
    "minimatch@^9.0.0": "^9.0.9",
    "websocket-driver": "^0.7.5"
  }
}
